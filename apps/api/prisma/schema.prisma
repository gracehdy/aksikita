// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma/"
  moduleFormat = "esm"
  runtime      = "bun"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String  @id @default(uuid())
  username     String  @unique
  displayName  String?
  phoneNumber  String?
  password     String?
  email        String  @unique
  profileImage String?

  reports      Report[]
  actions      Action[]
  volunteers   Volunteer[]
  points       Point[]
  certificates Certificate[]
  rewards      Reward[]

  createdAt DateTime @default(now()) @map("created_at")
}

model Report {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String
  category    String
  postType    Boolean
  location    String?
  createdAt   DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id])
  media   Media[]
  actions Action[]
}

model Media {
  id       String  @id @default(uuid())
  reportId String
  type     String?

  report Report @relation(fields: [reportId], references: [id])
}

model Action {
  id            String    @id @default(uuid())
  reportId      String
  userId        String
  content       String?
  mediaId       String?
  category      String?
  assemblyPoint String?
  scheduledAt   DateTime?
  requiredPeople Int?

  report Report @relation(fields: [reportId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  volunteers Volunteer[]
}

model Volunteer {
  id             Int     @id @default(autoincrement())
  actionId       String
  fullName       String
  email          String
  phone          String
  healthCondition String?
  reason         String?
  registeredBy   String?
  action         Action  @relation(fields: [actionId], references: [id])
  user           User?    @relation(fields: [registeredBy], references: [id])
  createdAt      DateTime @default(now())
}

model Point {
  id     String  @id @default(uuid())
  userId String
  source String?
  value  Int?

  user    User     @relation(fields: [userId], references: [id])
  rewards Reward[]
}

model Badge {
  id          String  @id @default(uuid())
  name        String?
  description String?

  rewards Reward[]
}

model Certificate {
  id     String  @id @default(uuid())
  userId String
  title  String?
  file   String?

  user    User     @relation(fields: [userId], references: [id])
  rewards Reward[]
}

model Reward {
  id            String @id @default(uuid())
  userId        String
  pointId       String
  badgeId       String
  certificateId String

  user        User        @relation(fields: [userId], references: [id])
  point       Point       @relation(fields: [pointId], references: [id])
  badge       Badge       @relation(fields: [badgeId], references: [id])
  certificate Certificate @relation(fields: [certificateId], references: [id])
}
