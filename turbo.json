{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "db:generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", "schema.prisma"],
      "outputs": ["node_modules/.prisma/client/**", "src/generated/prisma"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", ".output/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["^db:generate"]
    }
  }
}
