model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  username       String   @unique
  displayName    String  // Maps to "nama lengkap"
  passwordHash   String
  profileMediaId String?  // String pointer for the file system / ID
  emailVerified  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([email])
  @@index([username])
}
